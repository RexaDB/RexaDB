{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RexaDB",
  "version": "1.3.0",
  "identifier": "com.rexadb",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run server:dev",
    "beforeBuildCommand": "next build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "RexaDB",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": false,
        "dragDropEnabled": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 21
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/rexadb-server"],
    "resources": {
      "../resources/java-bridge/dist/bridge.jar": "bridge.jar",
      "../resources/java-bridge/dist/jre/": "jre/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "Developer ID Application: Hammadi Shahin (B5UL5U45T7)"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/rexadbapp/rexadb-app/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBOTk3RTI3MTZFMDZFRjkKUldUNWJ1QVdKMzZaNmxZcmZoUXZ2VWVzT3A1djBKaVZ0Qm1Dakpra0hZdWsxQVN5UkxqUXovUjkK"
    }
  }
}
